<Window x:Class="DataRecovery.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DataRecovery.App.ViewModels"
        xmlns:conv="clr-namespace:DataRecovery.App.Converters"
        mc:Ignorable="d"
        Title="DataRevive - Advanced Local File Recovery" 
        Icon="Assets/logo.png"
        Height="850" Width="1340"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" 
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleLeftPaneCommand}"/>
        <KeyBinding Key="B" Modifiers="Control+Alt" Command="{Binding ToggleRightPaneCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <conv:BoolToAccentBrushConverter x:Key="BoolToAccentBrushConverter"/>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="BorderBrush" Value="#2EA043"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pbd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pbd" Property="Background" Value="#2EA043"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pbd" Property="Background" Value="#1C6526"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Pbd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smooth Windows Explorer Style GridSplitter -->
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ShowsPreview" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Padding="2,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border x:Name="SplitGrip" Width="2" Background="{DynamicResource BorderBrushBase}" 
                                    CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitGrip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="SplitGrip" Property="Width" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Explorer Filter Popup Item Button Style -->
        <Style x:Key="PopupMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pmb" Background="{TemplateBinding Background}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pmb" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic DataGrid Column Headers -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushBase}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Dynamic DataGrid Row & Cells -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource DataGridRowBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DataGridRowSelectedTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DataGridRowSelectedTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dynamic Button Style -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushBase}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic ToggleButton Style for Explorer Filter Drops -->
        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushBase}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Tbd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tbd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tbd" Property="Background" Value="{DynamicResource CardSelectedBrush}"/>
                                <Setter TargetName="Tbd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Focusable="False"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TxtBd" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TxtBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBd" Background="{DynamicResource TabBackgroundBrush}" 
                                BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="0,0,0,2" 
                                Margin="0,0,4,0" Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource TabSelectedBackgroundBrush}"/>
                                <Setter TargetName="TabBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top App Header -->
            <RowDefinition Height="*"/>    <!-- Dynamic Content Area -->
            <RowDefinition Height="Auto"/> <!-- Footer Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top App Header with Theme Switcher & Navigation -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="18,12" 
                BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <!-- App Brand & Title -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border CornerRadius="8" ClipToBounds="True" Width="36" Height="36" Margin="0,0,12,0" 
                            VerticalAlignment="Center" BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1">
                        <Image Source="Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="DataRevive" FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PRO FORENSIC" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                </StackPanel>

                <!-- Navigation, Theme Switcher & Security Badges -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Navigation Buttons -->
                    <Button Content="💽 Drive Selection" Command="{Binding SwitchToSelectionViewCommand}" 
                            Height="34" Padding="14,0" Margin="4,0"/>
                    <Button Content="🔍 Scan &amp; Results" Command="{Binding SwitchToResultsViewCommand}" 
                            Height="34" Padding="14,0" Margin="4,0"/>

                    <!-- THEME TOGGLE BUTTON -->
                    <Border Background="{DynamicResource ButtonBackgroundBrush}" 
                            BorderBrush="{DynamicResource BorderBrushBase}" 
                            BorderThickness="1" CornerRadius="18" Margin="8,0" Padding="2">
                        <Button Command="{Binding ToggleThemeCommand}" 
                                Height="30" Padding="12,0" 
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" ToolTip="Switch between Dark and Light mode">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ThemeIcon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ThemeText}" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- SIDEBAR LAYOUT CONTROLS (VS CODE STYLE: TOP RIGHT) -->
                    <Border Background="{DynamicResource ButtonBackgroundBrush}" 
                            BorderBrush="{DynamicResource BorderBrushBase}" 
                            BorderThickness="1" CornerRadius="8" Margin="4,0,8,0" Padding="2"
                            Visibility="{Binding CurrentView, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ScanResults}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Toggle Left Folder Tree -->
                            <Button Command="{Binding ToggleLeftPaneCommand}" 
                                    ToolTip="Toggle Left Folders Sidebar (Ctrl+B)"
                                    Height="28" Width="32" Padding="0" Margin="1,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Grid Width="16" Height="13">
                                    <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="1.2" CornerRadius="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="1,0,0,1"
                                                    Background="{Binding IsLeftPaneVisible, Converter={StaticResource BoolToAccentBrushConverter}}"/>
                                            <Border Grid.Column="0" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,1,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Toggle Right Preview & Inspector -->
                            <Button Command="{Binding ToggleRightPaneCommand}" 
                                    ToolTip="Toggle Right Preview &amp; Inspector Pane (Ctrl+Alt+B)"
                                    Height="28" Width="32" Padding="0" Margin="1,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Grid Width="16" Height="13">
                                    <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="1.2" CornerRadius="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="5"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="1" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="1,0,0,0"/>
                                            <Border Grid.Column="1" CornerRadius="0,1,1,0"
                                                    Background="{Binding IsRightPaneVisible, Converter={StaticResource BoolToAccentBrushConverter}}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Security Status Indicators -->
                    <Border Background="{DynamicResource BadgeBackgroundBrush}" 
                            BorderBrush="#2EA043" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="6,0,6,0">
                        <TextBlock Text="🔒 Write-Blocking Active" Foreground="#2EA043" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="{DynamicResource BadgeBackgroundBrush}" 
                            BorderBrush="#D29922" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="🛡️ Anti-Overwrite Guard" Foreground="#D29922" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Dynamic Content Area -->
        <Grid Grid.Row="1">

            <!-- ============================================================ -->
            <!-- VIEW A: EaseUS Inspired Drive & Location Selection Screen    -->
            <!-- ============================================================ -->
            <Grid Visibility="{Binding CurrentView, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=DriveSelection}" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Refresh -->
                    <RowDefinition Height="Auto"/> <!-- Internal Drives Section -->
                    <RowDefinition Height="Auto"/> <!-- Specify a Location Section -->
                    <RowDefinition Height="*"/>    <!-- Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Destination & Start Button -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Select a location to search for lost data" FontSize="22" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Choose a local disk, recycle bin, or specific folder to perform deep file recovery." 
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Content="🔄 Refresh Drives" Command="{Binding RefreshDevicesCommand}" DockPanel.Dock="Right" Height="36" Padding="16,0" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Section: Internal Drives -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBlock Text="Internal Drives &amp; Devices" FontSize="15" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,16,16"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Drive Card -->
                                <Border Width="290" 
                                        Background="{DynamicResource CardBackgroundBrush}" 
                                        BorderBrush="{DynamicResource CardBorderBrush}" 
                                        BorderThickness="2" CornerRadius="10" Padding="16" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Drive Icon -->
                                        <Border Grid.Column="0" Width="40" Height="40" 
                                                Background="{DynamicResource ButtonBackgroundBrush}" 
                                                CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="💽" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding CardTitle}" FontWeight="Bold" FontSize="14" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left"/>
                                                <!-- Checkmark Badge if selected -->
                                                <Border Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Background="{DynamicResource AccentBrush}" CornerRadius="10" Width="20" Height="20" DockPanel.Dock="Right">
                                                    <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DockPanel>

                                            <!-- Storage Bar -->
                                            <ProgressBar Margin="0,10,0,6" Height="6" Minimum="0" Maximum="100" Value="{Binding UsedPercentage, Mode=OneWay}" 
                                                         Background="{DynamicResource BorderBrushBase}" 
                                                         Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>

                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding UsedVsTotalDisplay}" FontSize="11" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left"/>
                                                <TextBlock Text="{Binding FileSystem}" FontSize="11" 
                                                           Foreground="{DynamicResource TextMutedBrush}" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Section: Specify a Location -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Text="Specify a Location" FontSize="15" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <WrapPanel Orientation="Horizontal">
                        <!-- Quick Card 1: Recycle Bin -->
                        <Border Margin="0,0,16,16" Width="220" 
                                Background="{DynamicResource CardBackgroundBrush}" 
                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                BorderThickness="1" CornerRadius="10" Padding="14" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding QuickSelectRecycleBinCommand}"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="{DynamicResource ButtonBackgroundBrush}" CornerRadius="8" Margin="0,0,12,0">
                                    <TextBlock Text="🗑️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Recycle Bin" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                                    <TextBlock Text="Scan deleted items" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Quick Card 2: Desktop -->
                        <Border Margin="0,0,16,16" Width="220" 
                                Background="{DynamicResource CardBackgroundBrush}" 
                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                BorderThickness="1" CornerRadius="10" Padding="14" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding QuickSelectDesktopCommand}"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="{DynamicResource ButtonBackgroundBrush}" CornerRadius="8" Margin="0,0,12,0">
                                    <TextBlock Text="🖥️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Desktop" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                                    <TextBlock Text="Scan Desktop files" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Quick Card 3: Disk Image -->
                        <Border Margin="0,0,16,16" Width="220" 
                                Background="{DynamicResource CardBackgroundBrush}" 
                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                BorderThickness="1" CornerRadius="10" Padding="14" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding BrowseDiskImageCommand}"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="{DynamicResource ButtonBackgroundBrush}" CornerRadius="8" Margin="0,0,12,0">
                                    <TextBlock Text="💾" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Load Disk Image" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                                    <TextBlock Text="Forensic RAW/IMG/DD" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Bottom Action Dock -->
                <Border Grid.Row="4" Background="{DynamicResource PanelBackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Destination Folder -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Export Recovery Destination:" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <DockPanel Margin="0,6,0,0">
                                <Button Content="Browse..." Command="{Binding BrowseDestinationCommand}" DockPanel.Dock="Right" Height="36" Padding="16,0" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="13"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- Big Accent Search Button -->
                        <Button Grid.Column="1" Content="Search for Lost Data ▶" Command="{Binding StartScanCommand}"
                                Height="48" Padding="28,0" Background="{DynamicResource AccentBrush}" 
                                FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Cursor="Hand"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================ -->
            <!-- VIEW B: DiskGenius Inspired Deep Scan & Recovery Screen     -->
            <!-- ============================================================ -->
            <Grid Visibility="{Binding CurrentView, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ScanResults}" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Partition Map Bar & Controls -->
                    <RowDefinition Height="Auto"/> <!-- Live Scan Telemetry -->
                    <RowDefinition Height="*"/>    <!-- Split View (Tree + Table + Inspector) -->
                </Grid.RowDefinitions>

                <!-- Top Partition Map & Actions -->
                <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" 
                        CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Toolbar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button Content="← Back to Drives" Command="{Binding SwitchToSelectionViewCommand}" Height="32" Padding="12,0" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding SelectedDevice.DisplayName, StringFormat='Scanning Target: {0}'}" 
                                           FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="▶ Rescan" Command="{Binding StartScanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                                        Height="32" Padding="14,0" Margin="4,0" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold"/>
                                <Button Content="⏹ Stop Scan" Command="{Binding StopScanCommand}" IsEnabled="{Binding IsScanning}"
                                        Height="32" Padding="14,0" Margin="4,0" Background="#A1260D" BorderBrush="#C93213" Foreground="#FFFFFF" FontWeight="Bold"/>
                                <Button Content="📥 Export Selected" Command="{Binding ExportSelectedFileCommand}"
                                        Height="32" Padding="14,0" Margin="4,0"/>
                                <Button Content="📦 Export All Found" Command="{Binding ExportAllFilesCommand}"
                                        Height="32" Padding="16,0" Margin="4,0" Background="#238636" BorderBrush="#2EA043" Foreground="#FFFFFF" FontWeight="Bold"/>

                                <!-- VS Code Style Side Panel Toggle Buttons -->
                                <Border Background="{DynamicResource ButtonBackgroundBrush}" 
                                        BorderBrush="{DynamicResource BorderBrushBase}" 
                                        BorderThickness="1" CornerRadius="6" Margin="6,0,0,0" Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Left Sidebar Toggle -->
                                        <Button Command="{Binding ToggleLeftPaneCommand}" 
                                                ToolTip="Toggle Folders Sidebar (Ctrl+B)"
                                                Height="28" Width="32" Padding="0" Margin="1,0"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Grid Width="16" Height="13">
                                                <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="1.2" CornerRadius="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="5"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" CornerRadius="1,0,0,1"
                                                                Background="{Binding IsLeftPaneVisible, Converter={StaticResource BoolToAccentBrushConverter}}"/>
                                                        <Border Grid.Column="0" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,1,0"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <!-- Right Sidebar Toggle -->
                                        <Button Command="{Binding ToggleRightPaneCommand}" 
                                                ToolTip="Toggle Preview &amp; Inspector (Ctrl+Alt+B)"
                                                Height="28" Width="32" Padding="0" Margin="1,0"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Grid Width="16" Height="13">
                                                <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="1.2" CornerRadius="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="5"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="1" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="1,0,0,0"/>
                                                        <Border Grid.Column="1" CornerRadius="0,1,1,0"
                                                                Background="{Binding IsRightPaneVisible, Converter={StaticResource BoolToAccentBrushConverter}}"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <!-- Partition Bar (DiskGenius style visual disk map) -->
                        <Border Grid.Row="1" Background="{DynamicResource ButtonBackgroundBrush}" 
                                BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1" CornerRadius="6" Height="30" ClipToBounds="True">
                            <Grid>
                                <!-- Progress fill -->
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ScanPercentage, Mode=OneWay}" 
                                             Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                                <!-- Partition Label -->
                                <DockPanel LastChildFill="False" Margin="10,0">
                                    <TextBlock Text="{Binding SelectedDevice.DisplayName}" FontWeight="SemiBold" FontSize="11" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding ProgressText}" FontWeight="Bold" FontSize="11" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Live Scan Telemetry -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBackgroundBrush}" 
                        CornerRadius="6" Padding="10,6" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock Text="Speed: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ScanSpeedText}" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,14,0"/>
                            <TextBlock Text="ETA: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding EtaText}" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,14,0"/>
                            <TextBlock Text="Total Discovered: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding TotalFilesFound}" FontWeight="Bold" Foreground="#2EA043" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Windows File Explorer 5-Way Split: Left Tree + Left Splitter + Center Table + Right Splitter + Right Inspector -->
                <Grid x:Name="ResultsSplitGrid" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <!-- Col 0: Left Explorer Navigation Tree -->
                        <ColumnDefinition x:Name="LeftCol" Width="280" MinWidth="180" MaxWidth="500"/>

                        <!-- Col 1: Left GridSplitter -->
                        <ColumnDefinition x:Name="LeftSplitterCol" Width="6"/>

                        <!-- Col 2: Center File List & Breadcrumbs -->
                        <ColumnDefinition x:Name="CenterCol" Width="*" MinWidth="350"/>

                        <!-- Col 3: Right GridSplitter -->
                        <ColumnDefinition x:Name="RightSplitterCol" Width="6"/>

                        <!-- Col 4: Right Preview & Inspector -->
                        <ColumnDefinition x:Name="RightCol" Width="380" MinWidth="240" MaxWidth="750"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Windows File Explorer Navigation Pane -->
                    <Border x:Name="LeftFolderBorder" Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" 
                            CornerRadius="8" BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header + Actions -->
                                <RowDefinition Height="*"/>    <!-- Collapsible TreeView -->
                            </Grid.RowDefinitions>

                            <!-- Navigation Pane Header -->
                            <DockPanel Grid.Row="0" Margin="4,2,4,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="📁" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Folders" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="⊞" Command="{Binding ExpandAllFoldersCommand}" ToolTip="Expand all folders" 
                                            Height="24" Width="26" Padding="0" Margin="2,0" FontSize="11" FontWeight="Bold"/>
                                    <Button Content="⊟" Command="{Binding CollapseAllFoldersCommand}" ToolTip="Collapse all folders" 
                                            Height="24" Width="26" Padding="0" Margin="2,0" FontSize="11" FontWeight="Bold"/>
                                    <Button Content="💾 Export" Command="{Binding ExportFolderCommand}" ToolTip="Export selected folder"
                                            Height="24" Padding="6,0" Margin="2,0" FontSize="11" Background="{DynamicResource ButtonBackgroundBrush}"/>
                                    <Button Content="◀" Command="{Binding ToggleLeftPaneCommand}" ToolTip="Hide left folders panel" 
                                            Height="24" Width="26" Padding="0" Margin="2,0" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Windows File Explorer Hierarchical TreeView -->
                            <TreeView x:Name="FolderTreeView" Grid.Row="1"
                                      ItemsSource="{Binding RootFolderNodes}"
                                      SelectedItemChanged="FolderTreeView_SelectedItemChanged"
                                      Background="Transparent" BorderThickness="0"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="2,3"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                        </Style.Resources>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Border CornerRadius="4" Padding="4,2" Margin="0,1" HorizontalAlignment="Stretch">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="📦 Export This Folder Hierarchy..." Command="{Binding DataContext.ExportFolderCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="⊞ Expand All" Command="{Binding DataContext.ExpandAllFoldersCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                                    <MenuItem Header="⊟ Collapse All" Command="{Binding DataContext.CollapseAllFoldersCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <DockPanel LastChildFill="True">
                                                <!-- Folder CheckBox for Bulk Export Selection -->
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                          VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>

                                                <!-- Badge Count on Right -->
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource ButtonBackgroundBrush}" 
                                                        CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding DisplayBadge}" FontSize="10" FontWeight="SemiBold" 
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>

                                                <!-- Folder Icon & Name -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Normal" FontSize="12" 
                                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>

                    <!-- Left Resizer GridSplitter -->
                    <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="Transparent" ShowsPreview="False" Cursor="SizeWE"/>

                    <!-- Center DataGrid -->
                    <Border x:Name="CenterDataBorder" Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" 
                            CornerRadius="8" BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Breadcrumb bar -->
                                <RowDefinition Height="Auto"/> <!-- Search & Bulk Selection Toolbar -->
                                <RowDefinition Height="*"/>    <!-- DataGrid -->
                            </Grid.RowDefinitions>

                            <!-- Windows File Explorer Breadcrumb Bar -->
                            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="6" 
                                    BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1" Padding="6,4" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <!-- Show Left Folders Tree button if hidden -->
                                    <Button Content="📁 ▶" Command="{Binding ToggleLeftPaneCommand}" ToolTip="Show folders tree"
                                            Height="26" Padding="8,0" Margin="0,0,6,0" DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="11"
                                            Visibility="{Binding IsLeftPaneVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                    <Button Content="⬆ Up" Command="{Binding NavigateUpFolderCommand}" ToolTip="Up to parent folder"
                                            Height="26" Padding="8,0" Margin="0,0,6,0" DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="11"/>
                                    <Button Content="💾 Root" Command="{Binding SelectRootFolderCommand}" ToolTip="Go to root"
                                            Height="26" Padding="8,0" Margin="0,0,8,0" DockPanel.Dock="Left" FontSize="11"/>

                                    <!-- Show Right Preview button if hidden -->
                                    <Button Content="◀ 👁️ Preview" Command="{Binding ToggleRightPaneCommand}" ToolTip="Show preview pane"
                                            Height="26" Padding="8,0" Margin="6,0,0,0" DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="11"
                                            Visibility="{Binding IsRightPaneVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                    <TextBlock Text="{Binding FilteredFilesCountText}" DockPanel.Dock="Right" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <TextBlock Text="{Binding CurrentBreadcrumbPath}" VerticalAlignment="Center" 
                                               FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>

                            <!-- Windows File Explorer Filter Toolbar -->
                            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Content="☑ Select All" Command="{Binding SelectAllFilesCommand}" Height="28" Padding="10,0" Margin="3,0" FontSize="11"/>
                                    <Button Content="☐ Deselect All" Command="{Binding DeselectAllFilesCommand}" Height="28" Padding="10,0" Margin="3,0" FontSize="11"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Search Input -->
                                    <TextBox Text="{Binding SearchFilterText, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="170" Height="28" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                             ToolTip="Search file names or extensions..."/>

                                    <!-- Windows File Explorer: Type Dropdown Filter with arrow ▾ -->
                                    <Grid Margin="0,0,6,0">
                                        <ToggleButton x:Name="TypeFilterBtn" Height="28" Padding="8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄 " FontSize="11"/>
                                                <TextBlock Text="Type" FontWeight="Medium" Margin="0,0,4,0"/>
                                                <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <Popup x:Name="TypeFilterPopup"
                                               IsOpen="{Binding IsChecked, ElementName=TypeFilterBtn, Mode=TwoWay}"
                                               StaysOpen="False"
                                               PlacementTarget="{Binding ElementName=TypeFilterBtn}"
                                               Placement="Bottom"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushBase}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,4,0,0"
                                                    MinWidth="280"
                                                    MaxWidth="360">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
                                                </Border.Effect>
                                                <StackPanel>
                                                    <TextBlock Text="Filter by File Type" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    
                                                    <Button Content="📄 All Types" Command="{Binding SetCategoryFilterCommand}" CommandParameter="All" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="📁 Deleted MFT Records" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Deleted" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="🗑️ Recycle Bin Files" Command="{Binding SetCategoryFilterCommand}" CommandParameter="RecycleBin" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="📄 Documents (PDF, DOCX, TXT, XLSX)" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Documents" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="🖼️ Photos &amp; Images (JPG, PNG, BMP)" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Images" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="🎬 Videos (MP4, MKV, AVI)" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Video" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="🎵 Audio (MP3, WAV, FLAC)" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Audio" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="📦 Archives (ZIP, RAR, 7Z)" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Archives" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>

                                                    <Separator Margin="0,8" Background="{DynamicResource BorderBrushBase}"/>
                                                    
                                                    <TextBlock Text="Detected Extensions:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding AvailableExtensions}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="{Binding StringFormat='. {0}'}" 
                                                                            Command="{Binding DataContext.SetExtensionFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Click="CloseFilterPopups_Click"
                                                                            Margin="2" Padding="6,2" FontSize="11"
                                                                            Background="{DynamicResource ButtonBackgroundBrush}" 
                                                                            BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <!-- Windows File Explorer: Date modified Dropdown Filter with arrow ▾ -->
                                    <Grid Margin="0,0,6,0">
                                        <ToggleButton x:Name="DateFilterBtn" Height="28" Padding="8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📅 " FontSize="11"/>
                                                <TextBlock Text="Date modified" FontWeight="Medium" Margin="0,0,4,0"/>
                                                <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <Popup x:Name="DateFilterPopup"
                                               IsOpen="{Binding IsChecked, ElementName=DateFilterBtn, Mode=TwoWay}"
                                               StaysOpen="False"
                                               PlacementTarget="{Binding ElementName=DateFilterBtn}"
                                               Placement="Bottom"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushBase}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,4,0,0"
                                                    MinWidth="280">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
                                                </Border.Effect>
                                                <StackPanel>
                                                    <TextBlock Text="Filter by Date Modified / Deleted" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    
                                                    <Button Content="🗓️ All Dates" Command="{Binding SetDatePresetCommand}" CommandParameter="All" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="🕒 Today" Command="{Binding SetDatePresetCommand}" CommandParameter="Today" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="📅 Past 7 Days" Command="{Binding SetDatePresetCommand}" CommandParameter="Past7Days" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="📅 Past 30 Days" Command="{Binding SetDatePresetCommand}" CommandParameter="Past30Days" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="🗓️ This Year" Command="{Binding SetDatePresetCommand}" CommandParameter="ThisYear" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    
                                                    <Separator Margin="0,8" Background="{DynamicResource BorderBrushBase}"/>
                                                    
                                                    <TextBlock Text="Custom Date Range:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    
                                                    <Grid Margin="0,2,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="From:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                        <DatePicker Grid.Column="1" SelectedDate="{Binding DateFilterStart, Mode=TwoWay}" Height="26"/>
                                                    </Grid>
                                                    
                                                    <Grid Margin="0,4,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="To:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                        <DatePicker Grid.Column="1" SelectedDate="{Binding DateFilterEnd, Mode=TwoWay}" Height="26"/>
                                                    </Grid>
                                                    
                                                    <Button Content="Apply Date Range" Command="{Binding ApplyCustomDateRangeCommand}" Click="CloseFilterPopups_Click"
                                                            Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" Height="28" Padding="10,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <!-- Windows File Explorer: Size Dropdown Filter with arrow ▾ -->
                                    <Grid Margin="0,0,6,0">
                                        <ToggleButton x:Name="SizeFilterBtn" Height="28" Padding="8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📊 " FontSize="11"/>
                                                <TextBlock Text="Size" FontWeight="Medium" Margin="0,0,4,0"/>
                                                <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <Popup x:Name="SizeFilterPopup"
                                               IsOpen="{Binding IsChecked, ElementName=SizeFilterBtn, Mode=TwoWay}"
                                               StaysOpen="False"
                                               PlacementTarget="{Binding ElementName=SizeFilterBtn}"
                                               Placement="Bottom"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushBase}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,4,0,0"
                                                    MinWidth="240">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
                                                </Border.Effect>
                                                <StackPanel>
                                                    <TextBlock Text="Filter by File Size" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    
                                                    <Button Content="📊 All Sizes" Command="{Binding SetSizePresetCommand}" CommandParameter="All" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="▫️ Tiny (0 – 10 KB)" Command="{Binding SetSizePresetCommand}" CommandParameter="Tiny" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="◽ Small (10 KB – 1 MB)" Command="{Binding SetSizePresetCommand}" CommandParameter="Small" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="◻️ Medium (1 MB – 16 MB)" Command="{Binding SetSizePresetCommand}" CommandParameter="Medium" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="◼️ Large (16 MB – 128 MB)" Command="{Binding SetSizePresetCommand}" CommandParameter="Large" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                    <Button Content="⬛ Huge (> 128 MB)" Command="{Binding SetSizePresetCommand}" CommandParameter="Huge" Click="CloseFilterPopups_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <!-- Clear Filters Reset Button -->
                                    <Button Content="✕ Clear Filters" Command="{Binding ClearAllFiltersCommand}" 
                                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="#DC2626" Foreground="White" BorderThickness="0"
                                            Height="28" Padding="10,0" Margin="4,0" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Virtualized File Table -->
                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding FilteredFiles}"
                                      SelectedItem="{Binding SelectedFile}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="False"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      Background="{DynamicResource PanelBackgroundBrush}"
                                      RowBackground="{DynamicResource DataGridRowBackgroundBrush}"
                                      AlternatingRowBackground="{DynamicResource DataGridRowAltBackgroundBrush}"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource DataGridLinesBrush}">
                                <DataGrid.Columns>
                                    <!-- Selection Checkbox -->
                                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>

                                    <!-- Recovered File Name (Original Name!) -->
                                    <DataGridTextColumn Header="Original File Name" Binding="{Binding FileName}" IsReadOnly="True" Width="2*"/>

                                    <!-- File Extension -->
                                    <DataGridTextColumn Header="Type ▾" Binding="{Binding Extension}" IsReadOnly="True" Width="75"/>

                                    <!-- Category -->
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="85"/>

                                    <!-- Size -->
                                    <DataGridTextColumn Header="Size ▾" Binding="{Binding DisplaySize}" IsReadOnly="True" Width="85"/>

                                    <!-- Recovery Status (Deleted MFT vs Carved) -->
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="110"/>

                                    <!-- Deletion/Modified Date -->
                                    <DataGridTextColumn Header="Date modified ▾" Binding="{Binding DisplayDate}" IsReadOnly="True" Width="135"/>

                                    <!-- Sector Offset -->
                                    <DataGridTextColumn Header="Offset" Binding="{Binding DisplayOffset}" IsReadOnly="True" Width="105"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Right Resizer GridSplitter -->
                    <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="Transparent" ShowsPreview="False" Cursor="SizeWE"/>

                    <!-- Right Inspector & Previewer -->
                    <Border x:Name="RightInspectorBorder" Grid.Column="4" Background="{DynamicResource PanelBackgroundBrush}" 
                            CornerRadius="8" BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Inspector Header with Hide Button -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="🗋" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Details" FontWeight="Bold" FontSize="13" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="▶" Command="{Binding ToggleRightPaneCommand}" ToolTip="Hide details panel (Ctrl+Alt+B)"
                                        Height="22" Width="24" Padding="0" DockPanel.Dock="Right" FontSize="10" FontWeight="Bold"/>
                            </DockPanel>

                            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedPreviewTabIndex, Mode=TwoWay}">
                                <!-- Unified Windows 11 Details Tab (Image Preview + Metadata + Folder Info) -->
                                <TabItem Header="🗋 Details">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                                        <Grid Margin="0,0,4,0">
                                            <!-- CASE A: FILE SELECTED -->
                                            <StackPanel Visibility="{Binding SelectedFile, Converter={StaticResource NotNullToVisibilityConverter}}">
                                                <!-- Top Preview Card -->
                                                <Border Background="#16181D" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushBase}" 
                                                        BorderThickness="1" MinHeight="160" MaxHeight="220" Margin="0,0,0,12" Padding="8">
                                                    <Grid>
                                                        <!-- Image Preview if image -->
                                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding PreviewImage, Converter={StaticResource NotNullToVisibilityConverter}}"/>

                                                        <!-- Non-image or placeholder icon -->
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding SelectedFile.DisplayIcon}" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                            <TextBlock Text="{Binding PreviewErrorMessage}" 
                                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                                       Foreground="#EF4444" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"
                                                                       Visibility="{Binding PreviewErrorMessage, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding SelectedFile.DisplayFileType}" FontSize="12"
                                                                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- File Name & Actions -->
                                                <TextBlock Text="{Binding SelectedFile.EffectiveFileName}" 
                                                           FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>

                                                <!-- Export Action Button -->
                                                <Button Content="📥 Export File" Command="{Binding ExportSelectedFileCommand}" 
                                                        Style="{StaticResource PrimaryButtonStyle}" Height="34" Margin="0,0,0,16"/>

                                                <!-- Windows 11 Details Section Header -->
                                                <TextBlock Text="Details" FontWeight="Bold" FontSize="13" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                                <!-- Key-Value Table -->
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="105"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Type -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedFile.DisplayFileType}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" Margin="0,3"/>

                                                    <!-- Size -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedFile.DisplaySize}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3"/>

                                                    <!-- Dimensions (Visible only when PreviewImageDimensions != null) -->
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Dimensions" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"
                                                               Visibility="{Binding PreviewImageDimensions, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreviewImageDimensions}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3"
                                                               Visibility="{Binding PreviewImageDimensions, Converter={StaticResource NotNullToVisibilityConverter}}"/>

                                                    <!-- File location -->
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="File location" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedFile.FileLocation}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3"/>

                                                    <!-- Date modified -->
                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Date modified" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedFile.DisplayDate}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3"/>

                                                    <!-- Status -->
                                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Status" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedFile.Status}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,3"/>

                                                    <!-- Sector Offset -->
                                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Sector Offset" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedFile.DisplayOffset}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>

                                                    <!-- Resident in MFT -->
                                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Resident MFT" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedFile.IsResident}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>

                                                    <!-- SHA-256 -->
                                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="SHA-256" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedFile.Sha256Hash}" FontFamily="Consolas" FontSize="10" Foreground="#2EA043" TextWrapping="Wrap" Margin="0,3"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- CASE B: FOLDER OR DRIVE SELECTED (When SelectedFile == null) -->
                                            <StackPanel Visibility="{Binding SelectedFile, Converter={StaticResource NullToVisibilityConverter}}">
                                                
                                                <!-- SUB-CASE B1: ROOT DRIVE SELECTED -->
                                                <StackPanel Visibility="{Binding SelectedFolderNode.IsRoot, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <!-- Top Drive Card -->
                                                    <Border Background="#16181D" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushBase}" 
                                                            BorderThickness="1" Height="160" Margin="0,0,0,12" Padding="8">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="🖴" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <TextBlock Text="Local Disk Drive" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Drive Name & Action -->
                                                    <TextBlock Text="{Binding SelectedDrive.CardTitle, FallbackValue='Local Disk Drive'}" 
                                                               FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>

                                                    <Button Content="📦 Export All Found" Command="{Binding ExportAllFilesCommand}" 
                                                            Style="{StaticResource PrimaryButtonStyle}" Height="34" Margin="0,0,0,16"/>

                                                    <!-- Details Section Header -->
                                                    <TextBlock Text="Details" FontWeight="Bold" FontSize="13" 
                                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                                    <!-- Key-Value Table for Drive -->
                                                    <Grid Margin="0,0,0,16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="105"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Local Disk" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" Margin="0,3"/>

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Space used" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDrive.DisplayUsedPercentage, FallbackValue='N/A'}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3"/>

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Space free" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDrive.DisplayFreeSize, FallbackValue='N/A'}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3"/>

                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Total size" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDrive.DisplayTotalSize, FallbackValue='N/A'}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3"/>

                                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="File system" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDrive.FileSystem, FallbackValue='NTFS'}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3"/>

                                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="BitLocker status" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Off" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>

                                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Protection" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Write-Blocking Active" Foreground="#22C55E" FontWeight="SemiBold" Margin="0,3"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- SUB-CASE B2: FOLDER SELECTED -->
                                                <StackPanel Visibility="{Binding SelectedFolderNode.IsRoot, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                    <!-- Top Folder Card -->
                                                    <Border Background="#16181D" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushBase}" 
                                                            BorderThickness="1" Height="160" Margin="0,0,0,12" Padding="8">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="📁" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <TextBlock Text="File folder" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Folder Name & Action -->
                                                    <TextBlock Text="{Binding SelectedFolderNode.Name, FallbackValue='Folder'}" 
                                                               FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>

                                                    <Button Content="📦 Export This Folder" Command="{Binding ExportFolderCommand}" 
                                                            Style="{StaticResource PrimaryButtonStyle}" Height="34" Margin="0,0,0,16"/>

                                                    <!-- Details Section Header -->
                                                    <TextBlock Text="Details" FontWeight="Bold" FontSize="13" 
                                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                                    <!-- Key-Value Table for Folder -->
                                                    <Grid Margin="0,0,0,16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="105"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedFolderNode.DisplayType}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" Margin="0,3"/>

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedFolderNode.DisplaySize}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3"/>

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Contains" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedFolderNode.TotalFilesCount, StringFormat='{}{0} files'}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3"/>

                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="File location" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedFolderNode.FileLocation}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3"/>

                                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Date modified" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedFolderNode.DisplayDate}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3"/>

                                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Status" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3"/>
                                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Discovered in Scan" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,3"/>
                                                    </Grid>
                                                </StackPanel>

                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- Text Content Preview Tab -->
                                <TabItem Header="📄 Text Content">
                                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" 
                                             FontFamily="Consolas" FontSize="11"
                                             Background="{DynamicResource InputBackgroundBrush}" 
                                             Foreground="{DynamicResource InputForegroundBrush}"
                                             BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             Margin="0,10,0,0" Padding="8"/>
                                </TabItem>

                                <!-- Hex Editor View Tab -->
                                <TabItem Header="💻 Hex Dump">
                                    <TextBox Text="{Binding PreviewHex, Mode=OneWay}" 
                                             FontFamily="Consolas" FontSize="11"
                                             Background="{DynamicResource InputBackgroundBrush}" 
                                             Foreground="#22C55E"
                                             BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1"
                                             IsReadOnly="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             Margin="0,10,0,0" Padding="8"/>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 3. Footer Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" Padding="14,6" 
                BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="DataRevive Active • Sector-Aligned Low-Level Engine" DockPanel.Dock="Left" 
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                <TextBlock Text="Pure Local Execution • Zero Telemetry • Industry Standard Forensic File Recovery" DockPanel.Dock="Right" 
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
