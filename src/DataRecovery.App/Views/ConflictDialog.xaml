<Window x:Class="DataRecovery.App.Views.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Name Conflict - DataRecovery Pro"
        Width="640" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" 
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Intro -->
            <RowDefinition Height="*"/>    <!-- Comparison Card -->
            <RowDefinition Height="Auto"/> <!-- Checkbox Apply to All -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚠️ File Conflict Detected" FontSize="18" FontWeight="Bold" Foreground="#F0883E"/>
            <TextBlock x:Name="TxtSummary" Text="A file with this name already exists in the recovery folder." 
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Comparison Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Existing File Card -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrushBase}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="📄 Destination File (Existing)" FontWeight="Bold" Foreground="#2EA043" FontSize="13" Margin="0,0,0,10"/>
                    <TextBlock Text="File Name:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtExistingName" Text="test.txt" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="File Size:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtExistingSize" Text="12.4 KB" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                    <TextBlock Text="Last Modified:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtExistingDate" Text="2026-11-20 14:32:10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Incoming File Card -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="📦 Recovered File (Incoming)" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,0,0,10"/>
                    <TextBlock Text="File Name:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtIncomingName" Text="test.txt" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="File Size:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtIncomingSize" Text="12.4 KB" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                    <TextBlock Text="Status / Date:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtIncomingDate" Text="Deleted (MFT) • 2026-11-23 11:15" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Checkbox: Apply to all -->
        <CheckBox Grid.Row="2" x:Name="ChkApplyToAll" Content="Apply this choice to all remaining conflicting files in this export"
                  Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="4,0,0,16"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnKeepBoth" Content="Keep Both (Rename)" Click="BtnKeepBoth_Click"
                    Height="36" Padding="14,0" Margin="4,0" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand"/>
            <Button x:Name="BtnOverwrite" Content="Replace Existing" Click="BtnOverwrite_Click"
                    Height="36" Padding="14,0" Margin="4,0" Background="#A1260D" BorderBrush="#C93213" Foreground="#FFFFFF" FontWeight="SemiBold" Cursor="Hand"/>
            <Button x:Name="BtnSkip" Content="Skip This File" Click="BtnSkip_Click"
                    Height="36" Padding="14,0" Margin="4,0" Background="{DynamicResource ButtonBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrushBase}" Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
